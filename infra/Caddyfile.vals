# Vals – oyun dosyaları /srv/vals içinde (statik); /api/* kullanım olayları ve rapor sunucusuna gider (127.0.0.1:8791, vals-olay servisi).
# Geçici adres sslip.io: kayıt gerektirmez, IP'yi adrese gömer. Yeni bir DuckDNS adı alınınca
# aynı bloğun başına eklenir:  vals.130-61-214-155.sslip.io, yeniad.duckdns.org {
vals.130-61-214-155.sslip.io {
	encode gzip
	header -Server
	handle /api/* {
		reverse_proxy 127.0.0.1:8791
	}
	handle {
		root * /srv/vals
		@nocache path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
